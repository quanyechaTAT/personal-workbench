# Shared by all project knowledge libraries. Copy into the system repository .env.
EMBED_MODEL_NAME=your-embedding-model
EMBED_API_KEY=
EMBED_BASE_URL=https://your-service.example/v1

# Optional, only when supported by the provider:
# EMBED_DIMENSIONS=1024

# Bailian qwen3.7-text-embedding: count exact tokens from single-input usage.total_tokens.
# This adds paid embedding requests for token measurement; cached vectors are reused.
# EMBED_TOKENIZER=provider-usage
# EMBED_TOKENIZER_MODEL=qwen3.7-text-embedding
# Alternatively provide the model's exact local tokenizer files (no network counting):
# EMBED_TOKENIZER_FILE=tokenizers/your-model/tokenizer.json
# EMBED_TOKENIZER_CONFIG_FILE=tokenizers/your-model/tokenizer_config.json

# Four-layer memory: all projects share this system file. Project .env files are not read.
# OCR / ASR / vision / multimodal keys inherit EMBED_API_KEY when omitted.
# Recognized EMBED_BASE_URL + EMBED_API_KEY derive the endpoints; model quota/permission is separate.
# Supports dashscope.aliyuncs.com and <WorkspaceId>.cn-beijing.maas.aliyuncs.com.
# Per-capability ENDPOINT and API_KEY overrides below are optional; no duplicate keys are required.
# Native endpoints are derived ONLY from a recognized Bailian HTTPS EMBED_BASE_URL origin.
# Other providers require explicit endpoints and compatible protocol adapters.
MEMORY_OCR_MODEL=qwen3.5-ocr
# AllocationQuota.FreeTierOnly: retain quota protection and explicitly choose an available model.
# Current workspace verified: MEMORY_OCR_MODEL=qwen-vl-ocr (same advanced_recognition protocol).
MEMORY_ASR_MODEL=qwen-audio-3.0-asr-flash-streaming
MEMORY_VISION_MODEL=qwen3.7-flash-2026-07-15
MEMORY_MULTIMODAL_MODEL=tongyi-embedding-vision-flash
# MEMORY_OCR_ENDPOINT=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
# MEMORY_ASR_ENDPOINT=wss://dashscope.aliyuncs.com/api-ws/v1/inference
# MEMORY_VISION_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
# MEMORY_MULTIMODAL_ENDPOINT=https://dashscope.aliyuncs.com/api/v1/services/embeddings/multimodal-embedding/multimodal-embedding
# MEMORY_OCR_API_KEY=
# MEMORY_ASR_API_KEY=
# MEMORY_VISION_API_KEY=
# MEMORY_MULTIMODAL_API_KEY=
# Set any capability's ENABLED=false to disable its requests.
# MEMORY_OCR_ENABLED=false
# MEMORY_ASR_ENABLED=false
# MEMORY_VISION_ENABLED=false
# MEMORY_MULTIMODAL_ENABLED=false
# Increment on same-name model/vector-space changes; then explicitly rebuild indexes.
MEMORY_EMBED_SPACE_REVISION=1
