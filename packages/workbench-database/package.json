{
	"name": "@earendil-works/workbench-database",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "tsgo -p tsconfig.build.json && shx mkdir -p dist/migrations && shx cp src/migrations/*.sql dist/migrations/",
		"test": "vitest --run"
	},
	"dependencies": {
		"@earendil-works/workbench-core": "0.1.0",
		"sqlite-vec": "0.1.9"
	},
	"devDependencies": {
		"@earendil-works/workbench-runtime": "0.1.0",
		"@types/node": "22.19.19",
		"shx": "0.4.0",
		"typescript": "5.9.3",
		"vitest": "4.1.9"
	},
	"engines": {
		"node": ">=22.19.0"
	}
}
