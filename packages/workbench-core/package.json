		"test": "vitest --run"
	},
	"dependencies": {
		"@earendil-works/workbench-runtime": "0.1.0",
		"typebox": "1.3.27"
	},
	"devDependencies": {
		"@types/node": "22.19.19",
		"shx": "0.4.0",
		"typescript": "5.9.3",
		"vitest": "4.1.9"
	},
	"engines": { "node": ">=22.19.0" }
}
