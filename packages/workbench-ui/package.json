{
	"name": "@earendil-works/workbench-ui",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"files": [
		"dist"
	],
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "tsgo --noEmit -p tsconfig.build.json && node scripts/build.mjs",
		"test": "vitest --run",
		"test:e2e": "playwright test --config playwright.config.ts",
		"check:e2e": "tsgo --noEmit -p tsconfig.e2e.json"
	},
	"dependencies": {
		"@earendil-works/workbench-core": "0.1.0",
		"@earendil-works/workbench-runtime": "0.1.0",
		"@tanstack/react-query": "5.102.8",
		"marked": "18.0.11",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"react-router": "7.18.3"
	},
	"devDependencies": {
		"@playwright/test": "1.63.0",
		"@types/node": "22.19.19",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"esbuild": "0.28.2",
		"jsdom": "26.1.0",
		"shx": "0.4.0",
		"typescript": "5.9.3",
		"vitest": "4.1.9"
	},
	"engines": {
		"node": ">=22.19.0"
	}
}
